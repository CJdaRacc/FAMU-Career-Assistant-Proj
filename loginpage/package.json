{
  "name": "loginpage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:server": "vitest -c vitest.server.config.ts",
    "test:server:ci": "vitest --run -c vitest.server.config.ts",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "mammoth": "^1.8.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.8.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.8.32",
    "c8": "^10.1.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.1.0",
    "mongodb-memory-server": "^10.1.4",
    "msw": "^2.6.6",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vite": "^7.3.3",
    "vitest": "^4.0.6",
    "whatwg-fetch": "^3.6.20"
  }
