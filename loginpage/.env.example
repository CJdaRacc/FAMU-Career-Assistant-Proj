# Example environment configuration for the FAMU Career Assistant project (server)
# Copy this file to ".env" (and optionally create ".env.local" to override locally)
# Then fill in the values as appropriate.

# Server port for the Express API
PORT=5000

# MongoDB connection string. Use your own credentials/cluster.
# Examples:
#  - Local dev: mongodb://127.0.0.1:27017
#  - Atlas: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional: specific database name to use when connecting
# If not set, the DB may be taken from the URI or driver default
MONGODB_DB=famu-career-assistant

# Path to the log file written by the server. Defaults to server/data/events.log if unset.
# You can keep the default or customize to an absolute path.
LOG_FILE=server/data/events.log

# Google Gemini API key (you can use any one of these variable names)
# The server will check in the following order:
#   GEMINI_API_KEY, GOOGLE_API_KEY, VITE_GEMINI_API_KEY, VITE_GOOGLE_API_KEY
# Obtain a key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# VITE_GEMINI_API_KEY=
# VITE_GOOGLE_API_KEY=
